# ═══════════════════════════════════════════════════════════════
# PG-Limiter Configuration
# Compatible with PasarGuard panel 5.x (OpenAPI spec 5.3.0+)
# ═══════════════════════════════════════════════════════════════

# Panel Configuration (Required)
PANEL_DOMAIN=your-panel-domain.com:8443
PANEL_USERNAME=admin
PANEL_PASSWORD=your_password

# PasarGuard v5+ API key (`pg_key_<uuid>`). When set, takes
# precedence over PANEL_USERNAME/PANEL_PASSWORD. Generate one in
# the panel under "Admins → API Keys". Either a password or an
# API key is required.
# PANEL_API_KEY=pg_key_xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Force a specific scheme ("https" or "http"). Leave empty to
# auto-fallback between both.
# PANEL_SCHEME=https

# Skip TLS certificate verification (only enable for self-signed
# development panels; not recommended for production).
# PANEL_INSECURE=false

# Telegram Bot (Required)
BOT_TOKEN=YOUR_BOT_TOKEN
# Comma-separated admin chat IDs
ADMIN_IDS=

# ═══════════════════════════════════════════════════════════════
# Limiter Settings
# ═══════════════════════════════════════════════════════════════

# Default IP limit per user
GENERAL_LIMIT=2

# Check interval in seconds (60-300)
CHECK_INTERVAL=60

# Default time before re-enabling disabled users (seconds)
# Users can have custom punishment times via Telegram
TIME_TO_ACTIVE_USERS=900

# Country code filter (IR, RU, CN, or empty for all)
COUNTRY_CODE=

# ═══════════════════════════════════════════════════════════════
# API Server (Optional)
# ═══════════════════════════════════════════════════════════════
# API_ENABLED=false
# API_HOST=0.0.0.0
# API_PORT=8080
# API_USERNAME=admin
# API_PASSWORD=secure_password
# The dashboard is served at /dashboard and /api/dashboard/state
# when the API server is enabled.

# ═══════════════════════════════════════════════════════════════
# HTTP client tuning (NEW — affects all panel calls)
# ═══════════════════════════════════════════════════════════════

# Connection pool size (per host). Increase for very large panels
# with many concurrent bulk operations.
# HTTP_POOL_SIZE=100

# Enable HTTP/2 (requires the optional `h2` package:
#   pip install 'httpx[http2]'
# ). Off by default to keep the install footprint minimal.
# HTTP2_ENABLED=false

# Default per-request timeout in seconds.
# PANEL_REQUEST_TIMEOUT=30

# ═══════════════════════════════════════════════════════════════
# Advanced Settings
# ═══════════════════════════════════════════════════════════════

# Timezone
TZ=UTC

# Log level: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO

# Database (SQLite by default)
DATABASE_URL=sqlite+aiosqlite:////var/lib/pg-limiter/data/pg_limiter.db

# Redis cache (optional; falls back to in-memory cache if missing)
# REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=
